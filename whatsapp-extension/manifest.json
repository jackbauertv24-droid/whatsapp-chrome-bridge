{
  "manifest_version": 3,
  "name": "WhatsApp Secure Bridge",
  "version": "1.1",
  "description": "Securely tunnels WhatsApp Web data to your API Gateway",
  "permissions": ["storage"],
  "host_permissions": ["*://web.whatsapp.com/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://web.whatsapp.com/*"]
    }
  ]
}
